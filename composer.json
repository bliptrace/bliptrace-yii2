{
    "name": "bliptrace/yii2",
    "version": "1.0.0",
    "description": "Yii2 SDK for Bliptrace — auto-captures exceptions and ships them to the ingest API. Thin adapter over bliptrace/php.",
    "keywords": [
        "yii2",
        "yii",
        "bliptrace",
        "error-tracking",
        "observability",
        "sdk"
    ],
    "type": "yii2-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bliptrace/php": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.0"
    },
    "suggest": {
        "yiisoft/yii2": "^2.0 — required to use the application component / error handler integration"
    },
    "autoload": {
        "psr-4": {
            "Bliptrace\\Yii2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bliptrace\\Yii2\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "extra": {
        "bootstrap": "Bliptrace\\Yii2\\Bootstrap"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../bliptrace-php",
            "options": {
                "symlink": true,
                "versions": { "bliptrace/php": "2.0.0" }
            }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
